# VerbaNova Environment Variables

# ─── MinIO / S3 Object Storage ──────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000           # Host:port del servidor MinIO
MINIO_BUCKET=voice-profiles         # Bucket para perfiles de voz
AWS_ACCESS_KEY_ID=minioadmin        # Credencial MinIO
AWS_SECRET_ACCESS_KEY=minioadmin    # Credencial MinIO
AWS_REGION=us-east-1                # Región AWS (puede ser ficticia con MinIO)

# ─── Backend Configuration ──────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0                # Host donde escucha el servidor FastAPI
BACKEND_PORT=8000                   # Puerto del backend
PYTHONUNBUFFERED=1                  # Para logs en tiempo real
PYTHONDONTWRITEBYTECODE=1           # No generar archivos .pyc

# ─── Frontend Configuration ────────────────────────────────────────────────
NEXT_PUBLIC_BACKEND_URL=http://backend:8000   # URL del backend (accesible desde cliente)
NEXT_PUBLIC_WS_URL=ws://backend:8000          # URL WebSocket (accesible desde cliente)
NEXT_PUBLIC_MINIO_ENDPOINT=minio:9000         # URL de MinIO desde frontend
NEXT_PUBLIC_MINIO_BUCKET=voice-profiles       # Bucket para subidas desde frontend

# ─── ML Models ────────────────────────────────────────────────────────────
HF_HOME=/app/.cache                 # Cache de Hugging Face (modelos)
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True  # CUDA memory fragmentation fix

# ─── Development Only ─────────────────────────────────────────────────────
# Estas variables se usan en desarrollo local, NO en Kubernetes

# Base de datos (si se usa Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/verbanota

# API Keys (si se usan servicios externos)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Debug mode
DEBUG=false
LOG_LEVEL=info
